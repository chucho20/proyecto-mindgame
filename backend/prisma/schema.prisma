generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id                     Int                   @id @default(autoincrement())
  nombreCompleto         String                @map("nombre_completo") @db.VarChar(150)
  correo                 String                @unique(map: "uq_usuarios_correo") @db.VarChar(150)
  nombreUsuario          String                @unique(map: "uq_usuarios_nombre_usuario") @map("nombre_usuario") @db.VarChar(50)
  passwordHash           String                @map("password_hash") @db.VarChar(255)
  edad                   Int?
  gradoCurso             String?               @map("grado_curso") @db.VarChar(50)
  rol                    RolUsuario
  avatar                 String?               @db.VarChar(100)
  aceptaTratamientoDatos Boolean               @map("acepta_tratamiento_datos")
  createdAt              DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime              @default(now()) @map("updated_at") @db.DateTime(0)
  puntosTotales          Int                   @default(0) @map("puntos_totales")
  nivelActual            Int                   @default(1) @map("nivel_actual")
  avatar                 String?                @db.VarChar(100)
  aceptaTratamientoDatos Boolean                @map("acepta_tratamiento_datos")

  puntosTotales          Int                    @default(0) @map("puntos_totales")
  nivelActual            Int                    @default(1) @map("nivel_actual")

  createdAt              DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime               @default(now()) @map("updated_at") @db.DateTime(0)

  actividadesCompletadas ActividadCompletada[]
  historiasCompletadas   HistoriaCompletada[]
  intentosRetos          IntentoReto[]
  logrosObtenidos        LogroObtenido[]
  passwordResets         PasswordReset[]
  progresoMisiones       ProgresoMision[]
  recompensasObtenidas   RecompensaObtenida[]
  gruposCreados          Grupo[]               @relation("DocenteGrupos")
  gruposEstudiante       GrupoEstudiante[]     @relation("EstudianteGrupos")
  recompensasObtenidas   RecompensaObtenida[]
  logrosObtenidos        LogroObtenido[]

  @@map("usuarios")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiraEn  DateTime @map("expira_en") @db.DateTime(0)
  usado     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  usuario Usuario @relation(
    fields: [usuarioId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_password_resets_usuario"
  )

  @@index([usuarioId], map: "fk_password_resets_usuario")
  @@index([tokenHash], map: "idx_password_resets_token_hash")
  @@map("password_resets")
}

model Mision {
  id               Int              @id @default(autoincrement())
  titulo           String           @db.VarChar(150)
  descripcion      String?          @db.Text
  orden            Int              @default(0)
  estado           EstadoMision     @default(activa)
  categoria        CategoriaMision  @default(historica)
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.DateTime(0)
  categoria        CategoriaMision  @default(historica)

  actividades      Actividad[]
  historias        Historia[]
  progresoMisiones ProgresoMision[]
  retos            Reto[]

  @@index([categoria], map: "idx_misiones_categoria")
  @@index([estado], map: "idx_misiones_estado")
  @@map("misiones")
}

model Historia {
  id                   Int                  @id @default(autoincrement())
  misionId             Int                  @map("mision_id")
  titulo               String               @db.VarChar(150)
  contenido            String               @db.Text
  orden                Int                  @default(0)
  estado               EstadoHistoria       @default(activa)
  createdAt            DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt            DateTime             @default(now()) @map("updated_at") @db.DateTime(0)

  mision               Mision               @relation(
    fields: [misionId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_historias_mision"
  )

  historiasCompletadas HistoriaCompletada[]

  @@index([misionId], map: "idx_historias_mision_id")
  @@map("historias")
}

model HistoriaCompletada {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  historiaId   Int      @map("historia_id")
  completadaEn DateTime @default(now()) @map("completada_en") @db.DateTime(0)

  historia Historia @relation(
    fields: [historiaId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_historias_completadas_historia"
  )

  usuario Usuario @relation(
    fields: [usuarioId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_historias_completadas_usuario"
  )

  @@unique([usuarioId, historiaId], map: "uq_historias_completadas_usuario_historia")
  @@index([historiaId], map: "fk_historias_completadas_historia")
  @@map("historias_completadas")
}

model Reto {
  id                Int           @id @default(autoincrement())
  misionId          Int           @map("mision_id")
  tipo              TipoReto
  enunciado         String        @db.Text
  retroalimentacion String?       @db.Text
  opciones          Json?
  respuestaCorrecta Json          @map("respuesta_correcta")
  puntos            Int           @default(10)
  orden             Int           @default(0)
  estado            EstadoReto    @default(activo)
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.DateTime(0)
  retroalimentacion String?       @db.Text

  intentosRetos     IntentoReto[]

  mision Mision @relation(
    fields: [misionId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_retos_mision"
  )

  @@index([misionId], map: "idx_retos_mision_id")
  @@map("retos")
}

model IntentoReto {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @map("usuario_id")
  retoId          Int      @map("reto_id")
  respuestaDada   Json     @map("respuesta_dada")
  esCorrecto      Boolean  @map("es_correcto")
  puntosObtenidos Int      @default(0) @map("puntos_obtenidos")
  resueltoEn      DateTime @default(now()) @map("resuelto_en") @db.DateTime(0)

  reto Reto @relation(
    fields: [retoId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_intentos_retos_reto"
  )

  usuario Usuario @relation(
    fields: [usuarioId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_intentos_retos_usuario"
  )

  @@index([retoId], map: "fk_intentos_retos_reto")
  @@index([usuarioId, retoId], map: "idx_intentos_retos_usuario_reto")
  @@map("intentos_retos")
}

model Actividad {
  id                     Int                   @id @default(autoincrement())
  misionId               Int?                  @map("mision_id")
  titulo                 String                @db.VarChar(150)
  descripcion            String?               @db.Text
  tipo                   String                @db.VarChar(50)
  orden                  Int                   @default(0)
  estado                 EstadoActividad       @default(activa)
  createdAt              DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime              @default(now()) @map("updated_at") @db.DateTime(0)
  retroalimentacion      String?               @db.Text
  puntos                 Int                   @default(0)
  mision                 Mision?               @relation(fields: [misionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_actividades_mision")
  id                     Int                    @id @default(autoincrement())
  misionId               Int?                   @map("mision_id")
  titulo                 String                 @db.VarChar(150)
  descripcion            String?                @db.Text
  retroalimentacion      String?                @db.Text
  tipo                   String                 @db.VarChar(50)
  orden                  Int                    @default(0)
  estado                 EstadoActividad        @default(activa)
  createdAt              DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime               @default(now()) @map("updated_at") @db.DateTime(0)

  mision Mision? @relation(
    fields: [misionId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_actividades_mision"
  )

  actividadesCompletadas ActividadCompletada[]

  @@index([misionId], map: "idx_actividades_mision_id")
  @@map("actividades")
}

model ActividadCompletada {
  id           Int       @id @default(autoincrement())
  usuarioId    Int       @map("usuario_id")
  actividadId  Int       @map("actividad_id")
  completadaEn DateTime  @default(now()) @map("completada_en") @db.DateTime(0)

  actividad Actividad @relation(
    fields: [actividadId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_actividades_completadas_actividad"
  )

  usuario Usuario @relation(
    fields: [usuarioId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_actividades_completadas_usuario"
  )

  @@unique([usuarioId, actividadId], map: "uq_actividades_completadas_usuario_actividad")
  @@index([actividadId], map: "fk_actividades_completadas_actividad")
  @@map("actividades_completadas")
}

model ProgresoMision {
  id           Int            @id @default(autoincrement())
  usuarioId    Int            @map("usuario_id")
  misionId     Int            @map("mision_id")
  estado       EstadoProgreso @default(en_progreso)
  iniciadaEn   DateTime?      @map("iniciada_en") @db.DateTime(0)
  completadaEn DateTime?      @map("completada_en") @db.DateTime(0)
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.DateTime(0)

  mision Mision @relation(
    fields: [misionId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_progreso_misiones_mision"
  )

  usuario Usuario @relation(
    fields: [usuarioId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_progreso_misiones_usuario"
  )

  @@unique([usuarioId, misionId], map: "uq_progreso_misiones_usuario_mision")
  @@index([misionId], map: "fk_progreso_misiones_mision")
  @@map("progreso_misiones")
}

model Nivel {
  id               Int      @id @default(autoincrement())
  numero           Int      @unique(map: "uq_niveles_numero")
  puntosRequeridos Int      @map("puntos_requeridos")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  @@map("niveles")
}

model Recompensa {
  id                   Int                  @id @default(autoincrement())
  nombre               String               @db.VarChar(150)
  descripcion          String?              @db.Text
  icono                String?              @db.VarChar(100)
  condicionTipo        TipoCondicion        @map("condicion_tipo")
  condicionValor       Int                  @map("condicion_valor")
  estado               EstadoRecompensa     @default(activa)
  createdAt            DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt            DateTime             @default(now()) @map("updated_at") @db.DateTime(0)
  recompensasObtenidas RecompensaObtenida[]

  @@index([estado], map: "idx_recompensas_estado")
  @@map("recompensas")
}

model RecompensaObtenida {
  id           Int        @id @default(autoincrement())
  usuarioId    Int        @map("usuario_id")
  recompensaId Int        @map("recompensa_id")
  obtenidaEn   DateTime   @default(now()) @map("obtenida_en") @db.DateTime(0)
  recompensa   Recompensa @relation(fields: [recompensaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recompensas_obtenidas_recompensa")
  usuario      Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recompensas_obtenidas_usuario")

  @@unique([usuarioId, recompensaId], map: "uq_recompensas_obtenidas_usuario_recompensa")
  @@index([recompensaId], map: "fk_recompensas_obtenidas_recompensa")
  @@map("recompensas_obtenidas")
}

model Logro {
  id              Int             @id @default(autoincrement())
  nombre          String          @db.VarChar(150)
  descripcion     String?         @db.Text
  icono           String?         @db.VarChar(100)
  condicionTipo   TipoCondicion   @map("condicion_tipo")
  condicionValor  Int             @map("condicion_valor")
  estado          EstadoLogro     @default(activa)
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.DateTime(0)
  logrosObtenidos LogroObtenido[]

  @@index([estado], map: "idx_logros_estado")
  @@map("logros")
}

model LogroObtenido {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  logroId    Int      @map("logro_id")
  obtenidoEn DateTime @default(now()) @map("obtenido_en") @db.DateTime(0)
  logro      Logro    @relation(fields: [logroId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_logros_obtenidos_logro")
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_logros_obtenidos_usuario")

  @@unique([usuarioId, logroId], map: "uq_logros_obtenidos_usuario_logro")
  @@index([logroId], map: "fk_logros_obtenidos_logro")
  @@map("logros_obtenidos")
}

model MensajePositivo {
  id        Int                   @id @default(autoincrement())
  contenido String                @db.Text
  contexto  String                @db.VarChar(100)
  estado    EstadoMensajePositivo @default(activa)
  createdAt DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime              @default(now()) @map("updated_at") @db.DateTime(0)

  @@index([contexto, estado], map: "idx_mensajes_positivos_contexto_estado")
  @@map("mensajes_positivos")
}

model Nivel {
  id               Int      @id @default(autoincrement())
  numero           Int      @unique
  nombre           String   @db.VarChar(100)
  puntosRequeridos Int      @map("puntos_requeridos")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@map("niveles")
}

model Recompensa {
  id             Int             @id @default(autoincrement())
  nombre         String          @db.VarChar(150)
  descripcion    String?         @db.Text
  icono          String?         @db.VarChar(255)
  condicionTipo  CondicionTipo   @map("condicion_tipo")
  condicionValor Int             @map("condicion_valor")
  estado         EstadoContenido @default(activa)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.DateTime(0)

  obtenidas RecompensaObtenida[]

  @@map("recompensas")
}

model RecompensaObtenida {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  recompensaId Int      @map("recompensa_id")
  obtenidaEn   DateTime @default(now()) @map("obtenida_en") @db.DateTime(0)

  usuario Usuario @relation(
    fields: [usuarioId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_recompensas_obtenidas_usuario"
  )

  recompensa Recompensa @relation(
    fields: [recompensaId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_recompensas_obtenidas_recompensa"
  )

  @@unique([usuarioId, recompensaId])
  @@index([recompensaId])
  @@index([usuarioId])
  @@map("recompensas_obtenidas")
}

model Logro {
  id             Int             @id @default(autoincrement())
  nombre         String          @db.VarChar(150)
  descripcion    String?         @db.Text
  icono          String?         @db.VarChar(255)
  condicionTipo  CondicionTipo   @map("condicion_tipo")
  condicionValor Int             @map("condicion_valor")
  estado         EstadoContenido @default(activa)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.DateTime(0)

  obtenidos LogroObtenido[]

  @@map("logros")
}

model LogroObtenido {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  logroId    Int      @map("logro_id")
  obtenidoEn DateTime @default(now()) @map("obtenido_en") @db.DateTime(0)

  usuario Usuario @relation(
    fields: [usuarioId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_logros_obtenidos_usuario"
  )

  logro Logro @relation(
    fields: [logroId],
    references: [id],
    onDelete: Cascade,
    onUpdate: NoAction,
    map: "fk_logros_obtenidos_logro"
  )

  @@unique([usuarioId, logroId])
  @@index([logroId])
  @@index([usuarioId])
  @@map("logros_obtenidos")
}

model MensajePositivo {
  id        Int             @id @default(autoincrement())
  contenido String          @db.Text
  contexto  String          @db.VarChar(100)
  estado    EstadoContenido @default(activa)
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime        @default(now()) @map("updated_at") @db.DateTime(0)

  @@index([contexto], map: "idx_mensajes_positivos_contexto")
  @@map("mensajes_positivos")
}

enum TipoReto {
  seleccion_multiple
  verdadero_falso
  relacion_elementos
  orden_cronologico
}

enum CategoriaMision {
  historica
  convivencia
}

enum EstadoProgreso {
  disponible
  en_progreso
  completada
}

enum EstadoMision {
  activa
  inactiva
}

enum EstadoHistoria {
  activa
  inactiva
}

enum EstadoActividad {
  activa
  inactiva
}

enum RolUsuario {
  estudiante
  docente
  administrador
}

enum EstadoReto {
  activo
  inactivo
}

enum CategoriaMision {
  historica
  convivencia
}

enum TipoCondicion {
  puntos
  nivel
}

enum EstadoRecompensa {
  activa
  inactiva
}

enum EstadoLogro {
  activa
  inactiva
}

enum EstadoMensajePositivo {
  activa
  inactiva
}

model Grupo {
  id        Int      @id @default(autoincrement())
  docenteId Int      @map("docente_id")
  nombre    String   @db.VarChar(100)
  codigo    String   @unique(map: "uq_grupos_codigo") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  docente     Usuario           @relation("DocenteGrupos", fields: [docenteId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_grupos_docente")
  estudiantes GrupoEstudiante[]

  @@index([docenteId], map: "idx_grupos_docente_id")
  @@map("grupos")
}

model GrupoEstudiante {
  id           Int      @id @default(autoincrement())
  grupoId      Int      @map("grupo_id")
  estudianteId Int      @map("estudiante_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  grupo      Grupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_grupo_estudiantes_grupo")
  estudiante Usuario @relation("EstudianteGrupos", fields: [estudianteId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_grupo_estudiantes_estudiante")

  @@unique([grupoId, estudianteId], map: "uq_grupo_estudiantes_grupo_estudiante")
  @@index([estudianteId], map: "idx_grupo_estudiantes_estudiante_id")
  @@map("grupo_estudiantes")
}

enum CondicionTipo {
  puntos
  nivel
}

enum EstadoContenido {
  activa
  inactiva
}